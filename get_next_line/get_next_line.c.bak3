#include "get_next_line.h"
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>

typedef struct s_node
{
	char			*content;
	size_t			len;
	struct s_list	*next;
}					t_node;

t_node	*ft_lstnew(char *content)
{
	t_node	*new_node;

	new_node = malloc(sizeof(t_node));
	if (!new_node)
		return (NULL);
	new_node->next = NULL;
	new_node->content = content;
	new_node->len = ft_strlen(content);
	return (new_node);
}

char	*ft_strchr(const char *s, int c)
{
	unsigned char	ch;

	ch = (unsigned char)c;
	while (*s)
	{
		if ((unsigned char)*s == ch)
			return ((char *)s);
		s++;
	}
	if (ch == '\0')
		return ((char *)s);
	return (NULL);
}

char	*ft_substr(char const *s, unsigned int start, size_t len)
{
	size_t	len_s;
	size_t	available;
	size_t	real_len;

	if (!s)
		return (NULL);
	len_s = ft_strlen(s);
	if (start >= len_s)
		return (ft_strndup("", 1));
	available = len_s - start;
	if (len > available)
		real_len = available;
	else
		real_len = len;
	return (ft_strndup(s + start, real_len));
}

char *extract_line_before_endl(t_node *node)
{
	int	i;
	char	*line;

	i = 0;
	while (node->content[i] && node->content[i] != '\n')
		i++;
	if (node->content[i] == '\0')
		return (node->content);
	line = ft_substr(node->content, 0, i);
	node->content = ft_substr(node->content, i, node->len - i);
	node->len = node->len - i;
	return (line);
}

char	*get_next_line(int fd)
{
	int	read_bytes;
	static t_node *node[4096];
	char	*buffer;
	char	*line;

	if (fd < 0 || BUFFER_SIZE <= 0)
		return (NULL);

	while (1)
	{
		if (node[fd] && ft_strchr(node[fd]->content, '\n'))
		{
			line = extract_line_before_endl(node[fd]);
			return (line);
		}
		buffer = malloc(BUFFER_SIZE + 1);
		if (!buffer)
			return (NULL);
		read_bytes = read(fd, buffer, BUFFER_SIZE);
		buffer[read_bytes] = '\0';
		if (read_bytes < 0)
			return (free(buffer), free_node(node[fd]), NULL);
		if (read_bytes == 0)
		{
			free(buffer);
			if (node[fd] && node[fd]->content)
			{
				line = ft_strndup(node[fd]->content, node[fd]->len);
				free_node(node[fd]);
				node[fd] = NULL;
				return (line);
			}
			free_node(node[fd]);
			node[fd] = NULL;
			return (NULL);
		}

		if (!node[fd])
			node[fd] = ft_lstnew(buffer, fd);
		else
			add_buff_to_node(node[fd], buffer);
		free(buffer);
	}
	return (NULL);
}

int main(void)
{
	int fd = open("text.txt", O_RDONLY);
	if (fd == -1)
	{
		printf("Error when open file.");
		return (1);
	}
	char *line = get_next_line(fd);
	int i = 0;
	while (line)
	{
		i++;
		printf("[%d]: %s\n",i , line);
		free(line);
		line = get_next_line(fd);
	}
	free(line);
	close(fd);
	return (0);
}
