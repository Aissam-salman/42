#include "get_next_line.h"
#include <fcntl.h>
#include <stddef.h>
#include <stdio.h>

int	have_endl(char *s)
{
	size_t		i;

	i = 0;
	while (s[i])
		if (s[i++] == '\n')
			return (1);
	return (0);
}

char	*ft_substr(char const *s, unsigned int start, size_t len)
{ size_t	len_s;
	size_t	available;
	size_t	real_len;

	if (!s)
		return (NULL);
	len_s = ft_strlen(s);
	if (start >= len_s)
		return (ft_strndup("", 1));
	available = len_s - start;
	if (len > available)
		real_len = available;
	else
		real_len = len;
	return (ft_strndup(s + start, real_len));
}

char *get_next_line(int fd)
{
	char	buffer[BUFFER_SIZE + 1];
	static char	*stash;
	char	*line;
	char	*tmp;
	int		read_bytes;
	size_t	i;

	if (fd < 0 || BUFFER_SIZE <= 0)
		return (NULL);
	read_bytes = 1;
	line = NULL;
	while (read_bytes > 0)
	{
		read_bytes = read(fd, buffer, BUFFER_SIZE);
		if (read_bytes < 0)
			return (NULL);
		if (read_bytes == 0)
		{
			if (!stash || stash[0] == '\0')
				return (free(stash), stash = NULL, NULL);
			line = ft_strndup(stash, ft_strlen(stash));
			if (stash)
				free(stash);
			stash = NULL;
			return (line);
		}
		buffer[read_bytes] = '\0';
		tmp = append(stash, buffer);
		free(stash);
		stash = tmp;
		if (have_endl(stash))
			break;
	}
	if (!stash)
		return (NULL);
	i = 0;
	while (stash[i] && stash[i] != '\n')
		i++;
	line = ft_substr(stash, 0, i + 1);
	tmp = ft_substr(stash, i + 1, ft_strlen(stash) - (i + 1));
	free(stash);
	stash = tmp;
	tmp = NULL;
	return (line);
}

int main(void)
{
	int	fd;
	fd = open("multiple_nl.txt", O_RDONLY);
	char *line = get_next_line(fd);
	while (line)
	{
		printf("%s", line);
		free(line);
		line = get_next_line(fd);
	}
	return (0);
}
