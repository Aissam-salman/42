#include "get_next_line.h"
#include <fcntl.h>
#include <stddef.h>
#include <stdio.h>


static int	have_endl(char *stash)
{
	size_t	i;

	i = 0;
	while (stash[i]) { if (stash[i] == '\n')
			return (1);
		i++;
	}
	return (0);
}

static char	*ft_before_endl(char *stash)
{
	size_t	i;

	i = 0;
	while (stash[i] && stash[i] != '\n')
		i++;
	if (stash[i] == '\n')
		i++;
	return (ft_strndup(stash, i));
}

char *ft_after_endl(char *stash)
{
	size_t i;

	i = 0;
	while (stash[i] && stash[i] != '\n')
		i++;
	if (!stash[i] || !stash[i + 1])
		return (NULL);
	return (ft_strndup(stash + i + 1, ft_strlen(stash) - i - 1));
}

char	*get_next_line(int fd)
{
	char buffer[BUFFER_SIZE + 1];
	static char *stash;
	int	r;
	char *tmp;
	char *line;

	if (fd < 0 || BUFFER_SIZE <= 0)
		return (NULL);
	r = 1;
	while (r > 0 && (!stash || !have_endl(stash)))
	{
		r = read(fd, buffer, BUFFER_SIZE);
		if (r == -1)
			return (free(stash), stash = NULL, NULL);
		buffer[r] = '\0';
		tmp = stash;
		stash = append(tmp, buffer);
		free(tmp);
	}
	if (!stash || !*stash)
			return (free(stash), stash = NULL, NULL);
	line = ft_before_endl(stash);
	tmp = stash;
	stash = ft_after_endl(tmp);
	free(tmp);
	return (line);
}

int main(void)
{
	int	fd;
	char *res;

	fd = open("text.txt", O_RDONLY);
	if (fd < 0)
		return (-1);
	while ((res = get_next_line(fd)) != NULL)
	{
		printf("%s", res);
		free(res);
	}
	close(fd);
	return (0);
}
